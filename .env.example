# Copia este archivo a .env y pon tus datos. .env no se sube a git: no compartas tu clave.
TMDB_API_KEY=tu_clave_tmdb
TZ=America/Mexico_City

# IP fija del Chinoppo
CHINOPPO_IP=192.168.1.16
# NAS que comparte las películas por NFS, y la ruta exportada (sin / inicial)
NFS_SERVER=192.168.1.17
NFS_FOLDER=volume1/Plex
# Carpeta del servidor donde está montado ese mismo NFS (se monta en el contenedor como /media/Plex)
MEDIA_PATH=/mnt/nas/media
